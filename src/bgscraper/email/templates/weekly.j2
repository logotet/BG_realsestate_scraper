<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body style="font-family: Arial, Helvetica, sans-serif; color: #333; max-width: 700px; margin: 0 auto; padding: 16px;">

<h2 style="color: #2c5282; border-bottom: 2px solid #2c5282; padding-bottom: 8px;">
  Седмичен обзор: {{ count }} активни обяви
</h2>

<p style="color: #666; font-size: 14px;">Седмичен дайджест от BGScraper</p>

{# Summary by neighborhood #}
<h3 style="color: #4a5568;">По квартали</h3>
<table style="width: 100%; border-collapse: collapse; font-size: 14px; margin-bottom: 24px;">
  <thead>
    <tr style="background: #edf2f7; text-align: left;">
      <th style="padding: 6px 8px; border-bottom: 2px solid #cbd5e0;">Квартал</th>
      <th style="padding: 6px 8px; border-bottom: 2px solid #cbd5e0; text-align: right;">Брой</th>
      <th style="padding: 6px 8px; border-bottom: 2px solid #cbd5e0; text-align: right;">Средна цена (EUR)</th>
    </tr>
  </thead>
  <tbody>
    {% for hood, items in by_hood.items()|sort %}
    <tr style="border-bottom: 1px solid #e2e8f0;">
      <td style="padding: 6px 8px;">{{ hood }}</td>
      <td style="padding: 6px 8px; text-align: right;">{{ items|length }}</td>
      <td style="padding: 6px 8px; text-align: right;">
        {% set prices = items|selectattr('price_eur')|map(attribute='price_eur')|list %}
        {% if prices %}{{ "{:,.0f}".format(prices|sum / prices|length) }}{% else %}&mdash;{% endif %}
      </td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{# Full listing table #}
<h3 style="color: #4a5568;">Всички активни обяви</h3>
<table style="width: 100%; border-collapse: collapse; font-size: 13px;">
  <thead>
    <tr style="background: #edf2f7; text-align: left;">
      <th style="padding: 6px; border-bottom: 2px solid #cbd5e0;">Обява</th>
      <th style="padding: 6px; border-bottom: 2px solid #cbd5e0;">Квартал</th>
      <th style="padding: 6px; border-bottom: 2px solid #cbd5e0; text-align: right;">Цена</th>
      <th style="padding: 6px; border-bottom: 2px solid #cbd5e0; text-align: right;">Площ</th>
      <th style="padding: 6px; border-bottom: 2px solid #cbd5e0;">Тип</th>
    </tr>
  </thead>
  <tbody>
    {% for li in listings %}
    <tr style="border-bottom: 1px solid #e2e8f0;">
      <td style="padding: 6px;">
        <a href="{{ li.url }}" style="color: #2b6cb0; text-decoration: none;">
          {{ li.title or 'Без заглавие' }}
        </a>
      </td>
      <td style="padding: 6px;">{{ li.neighborhood or '—' }}</td>
      <td style="padding: 6px; text-align: right;">
        {{ "{:,}".format(li.price_eur) if li.price_eur else '—' }}
      </td>
      <td style="padding: 6px; text-align: right;">
        {{ li.area_sqm|round(0)|int if li.area_sqm else '—' }} m&sup2;
      </td>
      <td style="padding: 6px; font-size: 12px;">{{ li.property_type }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<p style="font-size: 12px; color: #999; margin-top: 24px; border-top: 1px solid #e2e8f0; padding-top: 8px;">
  BGScraper &middot; седмичен автоматичен имейл
</p>

</body>
</html>
