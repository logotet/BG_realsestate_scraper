# --- Database ---
DATABASE_URL=sqlite:///./data/listings.db
RENT_DATABASE_URL=sqlite:///./data/rent_listings.db

# --- HTTP / scraper ---
REQUEST_TIMEOUT=20
REQUEST_MIN_DELAY=1.5
REQUEST_MAX_DELAY=4.0
REQUEST_MAX_RETRIES=3
HTTP_PROXY=
STALE_DAYS=3
MAX_LIST_PAGES=20

# --- Filters ---
PRICE_CAP_APARTMENT_EUR=350000
PRICE_CAP_HOUSE_EUR=550000
RENT_PRICE_MIN_EUR=450
RENT_PRICE_CAP_EUR=700
FUZZY_THRESHOLD=80

# --- Email (Gmail app password recommended) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vladimir.vasilev09@gmail.com
SMTP_PASSWORD=replace_with_app_password
EMAIL_FROM=vladimir.vasilev09@gmail.com
EMAIL_TO=vladimir.vasilev09@gmail.com

# --- Scheduler ---
TZ=Europe/Sofia
DAILY_HOUR=7
DAILY_MINUTE=0
WEEKLY_DAY=mon
WEEKLY_HOUR=8
WEEKLY_MINUTE=0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/bgscraper.log
